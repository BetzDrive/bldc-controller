# Place all bazel build artifacts under this directory
build --symlink_prefix=bazel-build/

# Enable platform-based CC toolchain resolution so that the firmware_binary
# platform transition actually selects the ARM cross-compiler.
build --incompatible_enable_cc_toolchain_resolution

# Never strip debug symbols
#build --strip=never
#
#build --copt=-O2
#build --copt=-ggdb
#build --copt=-fomit-frame-pointer
#build --copt=-falign-functions=16
#build --cxxopt=-std=c++14
#build --linkopt=-lc
#build --linkopt=-lm
#build --linkopt=-lnosys
